APP_NAME=VeriShield
ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Gemini stays server-side. Recommended stable model for this project.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
# Automatic capacity fallback order for 429/5xx/model-unavailable errors.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# Google SDK already retries transient failures; keep app-level retries low so failover is fast.
GEMINI_RETRY_ATTEMPTS=1
# If every Gemini model is temporarily overloaded, continue with clearly-labelled local OCR/OpenCV evidence.
GEMINI_ALLOW_LOCAL_FALLBACK=true
GEMINI_MOCK=false

# JWT / auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=720

# Leave blank for zero-setup SQLite. PostgreSQL is also supported, e.g.
# postgresql+psycopg://postgres:password@localhost:5432/verishield
DATABASE_URL=

# Optional. If blank in development, VeriShield creates a local ignored dev key.
# Must be URL-safe base64 for exactly 32 bytes in production.
DATA_ENCRYPTION_KEY=

# Optional Windows Tesseract path, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Demo accounts are seeded only when true.
DEMO_MODE=true
DEMO_PASSWORD=Demo@12345

# Optional Hardhat / EVM anchoring. Local SHA-256 revision chain works even when false.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
